"""Profiler helpers generated by the custom-op-acceptance workflow."""
from __future__ import annotations

import csv
import json
import shutil
import time
from pathlib import Path
from typing import Any


def profiler_environment_ready(require_pta: bool) -> tuple[bool, list[str]]:
    missing = []
    if shutil.which("npu-smi") is None:
        missing.append("npu-smi")
    try:
        import mindspore  # noqa: F401
    except ImportError:
        missing.append("mindspore")
    if require_pta:
        try:
            import torch  # noqa: F401
        except ImportError:
            missing.append("torch")
        try:
            import torch_npu  # noqa: F401
        except ImportError:
            missing.append("torch_npu")
    return not missing, missing


def write_profile_summary(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def _to_float(value: Any) -> float | None:
    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return None


def _normalize_kernel_name(name: str) -> str:
    normalized = str(name).strip()
    if "/" in normalized:
        normalized = normalized.rsplit("/", 1)[-1]
    return normalized


def _first_present(row: dict[str, Any], names: tuple[str, ...]) -> Any:
    for name in names:
        if name in row and row[name] not in (None, ""):
            return row[name]
    return None


def _extract_csv_kernel_records(path: Path) -> list[dict[str, Any]]:
    name_columns = ("Name", "Op Name", "Kernel Name", "Task Name", "op_name", "kernel_name")
    duration_columns = ("Duration(us)", "Task Duration(us)", "dur", "Duration")
    records = []
    with path.open("r", encoding="utf-8-sig", newline="") as handle:
        reader = csv.DictReader(handle)
        for row in reader:
            name = _first_present(row, name_columns)
            duration = _to_float(_first_present(row, duration_columns))
            if not name or duration is None or duration <= 0:
                continue
            records.append(
                {
                    "name": _normalize_kernel_name(str(name)),
                    "duration_us": duration,
                    "source": str(path),
                }
            )
    return records


def _json_events(payload: Any) -> list[dict[str, Any]]:
    if isinstance(payload, list):
        return [event for event in payload if isinstance(event, dict)]
    if isinstance(payload, dict):
        events = payload.get("traceEvents") or payload.get("events") or []
        if isinstance(events, list):
            return [event for event in events if isinstance(event, dict)]
    return []


def _event_kernel_name(event: dict[str, Any]) -> str | None:
    generic_names = {"Computing", "Communication", "Runtime", "NPU"}
    raw_name = event.get("name")
    args = event.get("args") if isinstance(event.get("args"), dict) else {}
    for key in ("kernel_name", "Kernel Name", "op_name", "Op Name", "name", "Name"):
        value = args.get(key)
        if value and str(value) not in generic_names:
            return _normalize_kernel_name(str(value))
    if raw_name and str(raw_name) not in generic_names:
        return _normalize_kernel_name(str(raw_name))
    return None


def _extract_json_kernel_records(path: Path) -> list[dict[str, Any]]:
    with path.open("r", encoding="utf-8") as handle:
        events = _json_events(json.load(handle))
    records = []
    for event in events:
        duration = _to_float(event.get("dur"))
        if duration is None or duration <= 0:
            continue
        name = _event_kernel_name(event)
        if not name:
            continue
        records.append(
            {
                "name": name,
                "duration_us": duration,
                "source": str(path),
            }
        )
    return records


def extract_kernel_records(profile_dir: Path) -> list[dict[str, Any]]:
    if not profile_dir.exists():
        return []
    csv_patterns = ("kernel_details.csv", "op_summary_*.csv")
    for pattern in csv_patterns:
        records = []
        for path in sorted(profile_dir.rglob(pattern)):
            records.extend(_extract_csv_kernel_records(path))
        if records:
            return records

    records = []
    json_patterns = ("trace_view.json", "msprof_*.json", "msprof_slice_*.json")
    for pattern in json_patterns:
        for path in sorted(profile_dir.rglob(pattern)):
            records.extend(_extract_json_kernel_records(path))
        if records:
            return records
    return records


def summarize_kernel_records(records: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "sequence": [record["name"] for record in records],
        "total_duration_us": sum(float(record["duration_us"]) for record in records),
        "records": records,
    }


def compare_kernel_summaries(ms_summary: dict[str, Any], pta_summary: dict[str, Any]) -> dict[str, Any]:
    ms_sequence = ms_summary.get("sequence", [])
    pta_sequence = pta_summary.get("sequence", [])
    status = "passed" if ms_sequence and ms_sequence == pta_sequence else "coverage_gap"
    reason = "" if status == "passed" else "MS/PTA parsed kernel sequences are empty or different"
    return {
        "status": status,
        "reason": reason,
        "ms_sequence": ms_sequence,
        "pta_sequence": pta_sequence,
    }




def timed_call(func, *args, **kwargs):
    start = time.perf_counter()
    result = func(*args, **kwargs)
    elapsed_ms = (time.perf_counter() - start) * 1000.0
    return result, elapsed_ms


def timed_call_loop(func, *args, sync_fn=None, warmup: int = 100, iters: int = 1000, **kwargs):
    """Loop-based end-to-end timing returning average us per step.

    Runs *warmup* iterations to stabilise the device, synchronises, then
    measures *iters* iterations and returns the average wall-clock time in
    microseconds.  No heavyweight profiler is active during timing.
    """
    for _ in range(warmup):
        func(*args, **kwargs)
    if sync_fn is not None:
        sync_fn()
    start = time.perf_counter()
    for _ in range(iters):
        func(*args, **kwargs)
    if sync_fn is not None:
        sync_fn()
    total_s = time.perf_counter() - start
    return (total_s / iters) * 1_000_000  # us / step


def ms_lightweight_sync() -> None:
    """Drain MindSpore async work before/after a timing region."""
    try:
        import mindspore as ms
        executor = getattr(ms.common.api, "_pynative_executor", None)
        sync = getattr(executor, "sync", None)
        if callable(sync):
            sync()
    except Exception:
        pass


def torch_lightweight_sync() -> None:
    """Drain PTA async work before/after a timing region."""
    try:
        import torch
        sync = getattr(torch.npu, "synchronize", None)
        if callable(sync):
            sync()
    except Exception:
        pass


# ---------------------------------------------------------------------------
# memory measurement
# ---------------------------------------------------------------------------

def ms_reset_peak_memory():
    """Reset MindSpore peak memory tracking.  Safe to call when hal is unavailable."""
    try:
        import mindspore as ms
        hal = getattr(ms, "hal", None)
        reset = getattr(hal, "reset_max_memory_allocated", None)
        if callable(reset):
            reset()
    except Exception:
        pass


def ms_peak_memory_mb() -> float | None:
    """Return MindSpore peak allocated device memory in MiB, or None."""
    try:
        import mindspore as ms
        hal = getattr(ms, "hal", None)
        fn = getattr(hal, "max_memory_allocated", None)
        if callable(fn):
            return float(fn()) / (1024.0 * 1024.0)
    except Exception:
        pass
    return None


def torch_reset_peak_memory():
    """Reset torch_npu peak memory tracking."""
    try:
        import torch
        npu = getattr(torch, "npu", None)
        reset = getattr(npu, "reset_max_memory_allocated", None)
        if callable(reset):
            reset()
    except Exception:
        pass


def torch_peak_memory_mb() -> float | None:
    """Return torch_npu peak allocated device memory in MiB, or None."""
    try:
        import torch
        npu = getattr(torch, "npu", None)
        fn = getattr(npu, "max_memory_allocated", None)
        if callable(fn):
            return float(fn()) / (1024.0 * 1024.0)
    except Exception:
        pass
    return None


def compare_memory(ms_mb: float | None, pta_mb: float | None, threshold: float = 1.10) -> dict[str, Any]:
    """Compare MS vs PTA peak memory.

    Always returns both values. When *ratio* exceeds *threshold* a reason is
    attached; the profile summary reports this as ``memory_status: note`` so
    the report can surface it as a non-blocking advisory.
    """
    if ms_mb is None or pta_mb is None:
        return {"status": "not_collected", "reason": "memory APIs unavailable"}
    ratio = ms_mb / pta_mb if pta_mb > 0 else float("inf")
    result: dict[str, Any] = {
        "status": "passed",
        "ms_peak_memory_mb": round(ms_mb, 3),
        "pta_peak_memory_mb": round(pta_mb, 3),
        "ratio": round(ratio, 4),
        "threshold": threshold,
        "reason": "",
    }
    if ratio > threshold:
        result["reason"] = f"MS/PTA memory ratio {ratio:.2f} exceeds threshold {threshold}"
    return result
